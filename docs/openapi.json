  "info": {
    "description": "받은 선물과 관계 맥락을 바탕으로 답례 가격대와 카테고리를 추천합니다.",
    "title": "Giftie AI 추천 서비스",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/agent/confirm": {
      "post": {
        "description": "사용자가 확인 화면에서 검토·수정한 결과를 확정하고 캘린더에 등록합니다.\n\n``/from-image`` 나 ``/from-gift-data`` 는 일정을 등록하지 않고 초안까지만 만듭니다.\n잘못 추출된 일정이 사용자 캘린더에 바로 박히면 되돌리기 어렵기 때문입니다.\n\n이 서비스는 상태를 보관하지 않으므로, 백엔드가 직전 응답을 들고 있다가\n사용자 수정본과 함께 그대로 되돌려주면 됩니다.\n\nArgs:\n    request: 사용자 수정본이 반영된 확정 요청.\n\nReturns:\n    확정된 기록, 캘린더 등록 결과, 알림 예약.",
        "operationId": "confirm_api_v1_agent_confirm_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-API-KEY",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "confirmDraft": {
                  "summary": "사용자 검토 후 확정",
                  "value": {
                    "approved": true,
                    "gift_data": {
                      "gift_name": "스타벅스 케이크",
                      "gift_price": 35000,
                      "person_name": "김민수",
                      "received_at": "2026-08-19",
                      "relationship": "대학 동기",
                      "target_date": "2026-09-10"
                    },
                    "register_calendar": true,
                    "workflow_id": "from-previous-response-workflow-id"
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/ConfirmRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfirmResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "API 키 인증 실패"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "요청 데이터 검증 실패"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "내부 처리 오류"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Bedrock 등 외부 서비스 오류"
          }
        },
        "summary": "Confirm",
        "tags": [
          "gift-agent"
        ]
      }
    },
    "/api/v1/agent/from-gift-data": {
      "post": {
        "description": "구조화된 선물데이터로 네 가지 준비 작업을 실행합니다.\n\nArgs:\n    request: 백엔드가 전달한 ``gift_data`` 요청 본문.\n\nReturns:\n    선물 기록, 캘린더, 알림, 추천/메시지를 합친 응답.",
        "operationId": "prepare_from_gift_data_api_v1_agent_from_gift_data_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-API-KEY",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
