                    }
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/GiftDataRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GiftAgentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "API 키 인증 실패"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "요청 데이터 검증 실패"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "내부 처리 오류"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Bedrock 등 외부 서비스 오류"
          }
        },
        "summary": "Prepare From Gift Data",
        "tags": [
          "gift-agent"
        ]
      }
    },
    "/api/v1/agent/from-image": {
      "post": {
        "description": "S3 이미지 주소를 선물데이터로 변환한 뒤 네 작업을 실행합니다.\n\n``MODEL_BACKEND=bedrock`` 또는 ``vllm``에서는 실제 이미지 분석을 수행하고,\n``mock``에서는 외부 모델 없이 고정 결과로 전체 연동 흐름을 검증합니다.",
        "operationId": "prepare_from_image_api_v1_agent_from_image_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-API-KEY",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "gift": {
                  "summary": "사용자가 '선물'을 고른 경우 — 답례 선물 추천 실행",
                  "value": {
                    "category": "gift",
