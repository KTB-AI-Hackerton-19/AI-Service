{
  "components": {
    "schemas": {
      "ApiErrorResponse": {
        "description": "모든 HTTP 오류가 공유하는 응답 형식.",
        "properties": {
          "detail": {
            "description": "사용자와 개발자가 읽을 수 있는 한글 오류 설명",
            "title": "Detail",
            "type": "string"
          },
          "error_code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "클라이언트가 분기 처리할 수 있는 오류 코드"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "요청 필드 검증 오류가 있을 때만 포함하는 세부 정보",
            "title": "Errors"
          },
          "status": {
            "const": "ERROR",
            "default": "ERROR",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "error_code",
          "detail"
        ],
        "title": "ApiErrorResponse",
        "type": "object"
      },
      "CalendarDraft": {
        "description": "캘린더 등록용 초안. ``calendar_info.payload``의 타입을 명시한 것입니다.\n\nJSON에서는 camelCase(``startTime``, ``targetDate`` …)로 나가고 파이썬에서는\nsnake_case로 다룹니다. 사용자가 확인 화면에서 이 구조를 수정해 ``/confirm``으로\n되돌려주면 그대로 Google Calendar에 등록됩니다.",
        "properties": {
          "calendarId": {
            "default": "primary",
            "title": "Calendarid",
            "type": "string"
          },
          "date": {
            "description": "일정 날짜(답례 준비일)",
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "description": {
            "default": "",
            "title": "Description",
            "type": "string"
          },
          "durationMinutes": {
            "default": 30,
            "maximum": 1440.0,
            "minimum": 1.0,
            "title": "Durationminutes",
            "type": "integer"
          },
          "eventId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Eventid"
          },
          "htmlLink": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Htmllink"
          },
          "provider": {
            "default": "GOOGLE_MCP_DRAFT",
            "title": "Provider",
            "type": "string"
          },
          "registerError": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Registererror"
          },
          "registered": {
            "default": false,
            "title": "Registered",
            "type": "boolean"
          },
          "remindersMinutes": {
            "items": {
              "type": "integer"
            },
            "title": "Remindersminutes",
            "type": "array"
          },
          "startTime": {
            "default": "10:00",
            "title": "Starttime",
            "type": "string"
          },
          "targetDate": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "답례를 실행할 날짜",
            "title": "Targetdate"
          },
          "timezone": {
            "default": "Asia/Seoul",
            "title": "Timezone",
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "title": "Title",
            "type": "string"
          },
          "workflowId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Workflowid"
          }
        },
        "required": [
          "title",
          "date"
        ],
        "title": "CalendarDraft",
        "type": "object"
      },
      "CategoryRecommendation": {
        "description": "Qwen이 제안한 하나의 선물 카테고리.",
        "properties": {
          "category": {
            "maxLength": 50,
            "minLength": 1,
            "title": "Category",
            "type": "string"
          },
          "product_examples": {
            "items": {
              "type": "string"
            },
            "maxItems": 3,
            "title": "Product Examples",
            "type": "array"
          },
          "reason": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          },
          "score": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score",
            "type": "integer"
          },
          "search_query": {
            "default": "",
            "maxLength": 200,
            "title": "Search Query",
            "type": "string"
          }
        },
        "required": [
          "category",
          "score",
          "reason"
        ],
        "title": "CategoryRecommendation",
        "type": "object"
      },
      "ConfirmRequest": {
        "description": "사용자가 확인 화면에서 검토·수정한 뒤 보내는 확정 요청.\n\nAI 서비스는 상태를 보관하지 않습니다. 백엔드가 ``/from-image`` 응답을 들고 있다가\n사용자 수정본과 함께 그대로 되돌려주면 됩니다.",
        "properties": {
          "approved": {
            "default": true,
            "description": "false면 아무것도 등록하지 않습니다.",
            "title": "Approved",
            "type": "boolean"
          },
          "calendar": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CalendarDraft"
              },
              {
                "type": "null"
              }
            ],
            "description": "사용자가 수정한 일정 초안. 생략하면 gift_data 로 다시 계산합니다."
          },
          "calendar_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Calendar Id"
          },
          "gift_data": {
            "$ref": "#/components/schemas/GiftData",
            "description": "사용자가 수정한 기록. records 에 남은 항목만 저장됩니다."
          },
          "google_access_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "사용자 Google OAuth access token. 없으면 서버 설정값을 씁니다.",
            "title": "Google Access Token"
          },
          "register_calendar": {
            "default": true,
            "title": "Register Calendar",
            "type": "boolean"
          },
          "workflow_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Workflow Id",
            "type": "string"
          }
        },
        "required": [
          "workflow_id",
          "gift_data"
        ],
        "title": "ConfirmRequest",
        "type": "object"
      },
      "ConfirmResponse": {
        "description": "확정 처리 결과.",
        "properties": {
          "approved": {
            "title": "Approved",
            "type": "boolean"
          },
          "calendar_info": {
            "$ref": "#/components/schemas/PreparedData"
          },
          "gift_data": {
            "$ref": "#/components/schemas/PreparedData"
          },
          "noti_info": {
            "$ref": "#/components/schemas/PreparedData"
          },
          "workflow_id": {
            "title": "Workflow Id",
            "type": "string"
          }
        },
        "required": [
          "workflow_id",
          "approved",
          "gift_data",
          "calendar_info",
          "noti_info"
        ],
        "title": "ConfirmResponse",
        "type": "object"
      },
      "ErrorCode": {
        "description": "API가 반환할 수 있는 오류 코드 전체 목록.\n\nSpring Boot와 프론트엔드는 한글 ``detail``을 파싱하지 않고 이 값을 기준으로\n분기합니다. 새 오류를 추가할 때는 임의 문자열을 쓰지 말고 반드시 여기에 먼저\n선언합니다.",
        "enum": [
          "INVALID_API_KEY",
          "VALIDATION_ERROR",
          "GIFT_INPUT_INVALID",
          "IMAGE_ANALYSIS_FAILED",
          "RECOMMENDATION_FAILED",
          "CONFIRMATION_FAILED",
          "AGENT_EXECUTION_FAILED",
          "BAD_REQUEST",
          "AUTHENTICATION_ERROR",
          "FORBIDDEN",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "CONFLICT",
          "RATE_LIMITED",
          "INTERNAL_SERVER_ERROR",
          "UPSTREAM_SERVICE_ERROR",
          "SERVICE_UNAVAILABLE",
          "UPSTREAM_TIMEOUT",
          "HTTP_ERROR"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "Gender": {
        "description": "상대방 성별. 추천 카테고리에 영향을 줍니다.",
        "enum": [
          "male",
          "female",
          "unknown"
        ],
        "title": "Gender",
        "type": "string"
      },
      "GiftAgentResponse": {
        "description": "네 비동기 작업 결과를 합친 최종 HTTP 응답.",
        "properties": {
          "calendar_info": {
            "$ref": "#/components/schemas/PreparedData"
          },
          "gift_data": {
            "$ref": "#/components/schemas/PreparedData"
          },
          "noti_info": {
            "$ref": "#/components/schemas/PreparedData"
          },
          "recommend_gift_info": {
            "$ref": "#/components/schemas/GiftRecommendationInfo"
          },
          "requires_confirmation": {
            "default": false,
            "description": "true면 아직 캘린더에 등록되지 않았습니다. 사용자 확인 후 /confirm 을 호출하세요.",
            "title": "Requires Confirmation",
            "type": "boolean"
          },
          "workflow_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "네 작업 결과를 연결하는 ID. /confirm 에 그대로 돌려주세요.",
            "title": "Workflow Id"
          }
        },
        "required": [
          "gift_data",
          "calendar_info",
          "noti_info",
          "recommend_gift_info"
        ],
        "title": "GiftAgentResponse",
        "type": "object"
      },
      "GiftData": {
        "description": "모든 후속 작업이 공통으로 사용하는 정규화된 선물 정보.\n\n앞쪽 일곱 필드는 기존 계약 그대로이며 **대표 1건**을 담습니다.\n(여러 건이면 받은 금액이 가장 큰 건)\n뒤쪽 필드는 전부 기본값이 있는 선택 항목이라, 이를 모르는 코드도 그대로 동작합니다.",
        "properties": {
          "age": {
            "anyOf": [
              {
                "maximum": 120.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Age"
          },
          "confidence": {
            "default": 1.0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "direction": {
            "$ref": "#/components/schemas/RecordDirection",
            "default": "received"
          },
          "event": {
            "anyOf": [
              {
                "maxLength": 50,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event"
          },
          "event_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Date"
          },
          "gender": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Gender"
              },
              {
                "type": "null"
              }
            ],
            "description": "답례 선물을 받을 상대의 성별. male/female, 모르면 생략 또는 null"
          },
          "gift_name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Gift Name",
            "type": "string"
          },
          "gift_price": {
            "exclusiveMinimum": 0.0,
            "maximum": 100000000.0,
            "title": "Gift Price",
            "type": "integer"
          },
          "needs_review": {
            "default": false,
            "title": "Needs Review",
            "type": "boolean"
          },
          "person_name": {
            "anyOf": [
              {
                "maxLength": 50,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Person Name"
          },
          "price_basis": {
            "$ref": "#/components/schemas/PriceBasis",
            "default": "stated",
            "description": "estimated면 gift_price가 이미지에 적힌 값이 아니라 추정치입니다."
          },
          "received_at": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Received At"
          },
          "record_type": {
            "$ref": "#/components/schemas/RecordKind",
            "default": "gift"
          },
          "records": {
            "description": "이미지에서 읽은 전체 기록. 비어 있으면 위 평면 필드가 유일한 기록입니다.",
            "items": {
              "$ref": "#/components/schemas/GiftRecordItem"
            },
            "title": "Records",
            "type": "array"
          },
          "relationship": {
            "anyOf": [
              {
                "maxLength": 50,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Relationship"
          },
          "review_reasons": {
            "items": {
              "type": "string"
            },
            "title": "Review Reasons",
            "type": "array"
          },
          "target_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Date"
          }
        },
        "required": [
          "gift_name",
          "gift_price"
        ],
        "title": "GiftData",
        "type": "object"
      },
      "GiftDataRequest": {
        "description": "선물데이터 직접 전달 API의 요청 본문.",
        "example": {
          "gift_data": {
            "age": 32,
            "gender": "male",
            "gift_name": "꽃",
            "gift_price": 23333,
            "person_name": "김영삼",
            "received_at": "2026-08-19",
            "relationship": "친구"
          }
        },
        "properties": {
          "gift_data": {
            "$ref": "#/components/schemas/GiftData"
          }
        },
        "required": [
          "gift_data"
        ],
        "title": "GiftDataRequest",
        "type": "object"
      },
      "GiftRecommendationInfo": {
        "description": "추천 결과와 사용자에게 보낼 감사 메시지.\n\n``status`` 가 ``SKIPPED`` 면 이 입력에 답례 선물 추천이 맞지 않는다는 뜻이며,\n``reason`` 에 그 이유가 들어갑니다. 오류가 아니므로 화면에 실패로 표시하지 마세요.",
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "message": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "status=SKIPPED 일 때의 사유",
            "title": "Reason"
          },
          "recommend_gift": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SimpleGiftRecommendationResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus",
            "default": "SUCCESS"
          }
        },
        "title": "GiftRecommendationInfo",
        "type": "object"
      },
      "GiftRecordItem": {
        "description": "이미지에서 뽑아낸 기록 1건.\n\n``GiftData``의 평면 필드는 대표 1건만 표현할 수 있지만, 실제 이미지에는\n계좌 거래내역 5건이나 선물함 목록 4건이 들어 있습니다. 그 전부가 여기에 담깁니다.\n\n``gift_price``와 달리 여기의 ``price``는 ``None``을 허용합니다.\n청첩장처럼 금액이 아예 없는 항목을 있는 그대로 표현하기 위해서입니다.",
