      "ImageRequest": {
        "description": "이미지 분석 API의 요청 본문. 현재는 S3 HTTP(S) 주소를 받습니다.",
        "properties": {
          "category": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InputCategory"
              },
              {
                "type": "null"
              }
            ],
            "description": "사용자가 화면에서 고른 종류. gift(선물) 또는 occasion(경조사). 생략하면 이미지 분석 결과로 판단합니다."
          },
          "image_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Image Url",
            "type": "string"
          }
        },
        "required": [
          "image_url"
        ],
        "title": "ImageRequest",
        "type": "object"
