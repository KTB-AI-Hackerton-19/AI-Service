            "default": "unknown"
          },
          "event": {
            "anyOf": [
              {
                "maxLength": 50,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event"
          },
          "event_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "청첩장의 예식일 등",
            "title": "Event Date"
          },
          "gift_name": {
            "default": "",
            "maxLength": 200,
            "title": "Gift Name",
            "type": "string"
          },
          "memo": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Memo"
          },
          "needs_review": {
