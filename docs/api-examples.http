### 확인할 것
### - products 가 [] 인 이유 : TAVILY_ENABLED=false 이거나 검색 결과가 없을 때입니다.
###                            rationale.product_basis 에 이유가 적힙니다.
### - needs_review=true      : 사용자 확인 화면에서 review_reasons 를 보여 주세요.
###                            읽지 못한 값(이름·날짜)을 사용자가 채운 뒤 /confirm 으로 보냅니다.
### - input_age 가 없는 이유 : 응답은 response_model_exclude_none 이라 null 필드를 뺍니다.


### 2-1. 여러 건이 든 이미지 — 장부·거래내역 사진
POST {{host}}/api/v1/agent/from-image
Content-Type: application/json
X-API-KEY: {{apiKey}}

{
  "image_url": "https://ktb-ai-hackathon-451071929405-ap-northeast-2-an.s3.ap-northeast-2.amazonaws.com/gift-images/demo/account-book-test.JPG"
}

### bedrock 모드 실제 응답 (약 14초). 레코드 배열만 발췌했습니다.
### {
###   "gift_data": {
###     "status": "SUCCESS",
###     "payload": {
###       "gift_name": "10,000",
###       "gift_price": 10000,
###       "records": [
###         { "record_id": "r0", "record_type": "receipt", "direction": "sent",
###           "gift_name": "10,000", "price": 10000, "price_basis": "stated",
###           "confidence": 0.3, "needs_review": true,
###           "review_reasons": ["모델 신뢰도가 낮습니다", "날짜를 읽지 못했습니다"],
###           "selected": true },
###         { "record_id": "r1", "gift_name": "5,000",  "price": 5000,  "...": "r0 과 동일" },
###         { "record_id": "r2", "gift_name": "2,000",  "price": 2000,  "...": "r0 과 동일" },
###         { "record_id": "r3", "gift_name": "10,523", "price": 10523, "...": "r0 과 동일" },
###         { "record_id": "r4", "gift_name": "31,513", "price": 31513, "...": "r0 과 동일" },
###         { "record_id": "r5", "gift_name": "5,913",  "price": 5913,  "...": "r0 과 동일" }
###       ],
###       "currency": "KRW",
###       "summary": "상대방에게 받은 10,000 (10,000원)",
###       "recordCount": 6,
###       "receivedCount": 1,
###       "totalAmount": 10000,
###       "resolvedTargetDate": "2026-09-18",
###       "targetDateEstimated": true,
###       "needs_review": true,
###       "review_reasons": ["모델 신뢰도가 낮습니다", "날짜를 읽지 못했습니다"]
###     }
###   },
###   "recommend_gift_info": { "...": "2번과 같은 형태" },
###   "workflow_id": "ca9505dc-4fa4-4f5f-abbd-833c8f4e1ad2",
###   "requires_confirmation": true
### }
###
### 확인할 것
### - record_type=receipt   : 영수증으로 분류된 건입니다. 답례 대상이 아니라서
###                           receivedCount 와 totalAmount 에 들어가지 않습니다.
### - confidence 0.3        : 손글씨·저해상도에서 낮게 나옵니다. needs_review 로 표시되니
###                           사용자 확인 화면을 반드시 거치게 하세요.
### - recordCount 6 vs receivedCount 1 : 두 값이 다른 것이 정상입니다.
###                           recordCount 는 저장할 기록 수, receivedCount 는 답례 대상 수입니다.


### 3. 확정 — 사용자가 검토·수정한 뒤 호출
### 1번 또는 2번 응답의 gift_data.payload 와 calendar_info.payload 를 그대로 넣고,
### 사용자가 고친 값만 바꿔서 보내면 됩니다.
POST {{host}}/api/v1/agent/confirm
Content-Type: application/json
X-API-KEY: {{apiKey}}

{
  "workflow_id": "여기에-1번-응답의-workflow_id",
  "gift_data": {
    "gift_name": "스타벅스 케이크",
    "gift_price": 35000,
    "person_name": "김민수",
    "relationship": "대학 동기",
    "received_at": "2026-08-19",
    "target_date": "2026-09-10"
  },
  "calendar": null,
  "approved": true,
  "register_calendar": true
}

### calendar 를 null 로 두면 gift_data 로 일정을 다시 계산합니다.
### google_access_token 을 넣지 않으면 등록을 시도하지 않고 초안만 확정합니다.
### 등록 실패도 HTTP 200 이며 calendar_info.payload.registerError 로 알려 줍니다.


### 4. 확정 — 실제 Google Calendar 에 등록
POST {{host}}/api/v1/agent/confirm
Content-Type: application/json
X-API-KEY: {{apiKey}}

{
  "workflow_id": "여기에-1번-응답의-workflow_id",
  "gift_data": {
    "gift_name": "스타벅스 케이크",
    "gift_price": 35000,
    "person_name": "김민수",
    "target_date": "2026-09-10"
  },
  "approved": true,
  "register_calendar": true,
  "google_access_token": "ya29...."
}


### 5. 여러 건을 직접 전달 — 2-1 의 추출 결과를 사용자가 손본 뒤 보내는 경우
### 이미지 없이 records 배열을 그대로 넘기는 경로입니다.
POST {{host}}/api/v1/agent/from-gift-data
Content-Type: application/json
X-API-KEY: {{apiKey}}

{
  "gift_data": {
    "gift_name": "축의금",
    "gift_price": 200000,
    "person_name": "최은비",
    "received_at": "2026-08-19",
    "records": [
      {"record_id": "r0", "record_type": "money", "direction": "received",
       "person_name": "김도윤", "gift_name": "축의금", "price": 100000,
       "received_at": "2026-08-19", "confidence": 1.0, "selected": true},
      {"record_id": "r1", "record_type": "money", "direction": "received",
       "person_name": "박서준", "gift_name": "축의금", "price": 50000,
       "received_at": "2026-08-19", "confidence": 1.0, "selected": true},
      {"record_id": "r2", "record_type": "money", "direction": "received",
       "person_name": "최은비", "gift_name": "축의금", "price": 200000,
       "received_at": "2026-08-19", "confidence": 1.0, "selected": true},
      {"record_id": "r3", "record_type": "money", "direction": "sent",
       "person_name": "카카오페이", "gift_name": "결제", "price": 38900,
       "received_at": "2026-08-18", "confidence": 1.0, "selected": true}
    ]
  }
}

### 확인할 것
### - recordCount   : 4  (저장할 기록 수)
### - receivedCount : 3  (답례 대상 수. 출금 건은 빠짐)
### - totalAmount   : 350000
### - summary       : "김도윤님 외 2명에게 받은 축의금 (총 350,000원)"
### - calendar_info.payload.description 에 대상자 명단


### 6. 인증 실패 확인 — 401 이 나와야 합니다
POST {{host}}/api/v1/agent/from-gift-data
Content-Type: application/json

{
  "gift_data": {"gift_name": "케이크", "gift_price": 35000}
}


### 7. 검증 실패 확인 — 422 가 나와야 합니다 (gift_price 는 1 이상 필수)
POST {{host}}/api/v1/agent/from-gift-data
Content-Type: application/json
X-API-KEY: {{apiKey}}

{
  "gift_data": {"gift_name": "케이크", "gift_price": 0}
}


### 8. 추천만 다시 실행 — 기록·캘린더·알림은 실행하지 않음
### 사용자가 확인 화면에서 나이·성별·예산·카테고리를 바꿨을 때 사용합니다.
POST {{host}}/api/v1/agent/recommend
Content-Type: application/json
X-API-KEY: {{apiKey}}

{
  "age": 32,
  "gender": "male",
  "budget_min": 18000,
  "budget_max": 27000,
  "categories": ["꽃·식물"],
  "gift_name": "꽃",
  "gift_price": 23333,
  "person_name": "김영삼",
  "relationship": "친구"
}
