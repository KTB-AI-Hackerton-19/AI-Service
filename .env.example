API_KEY=change-this-secret
MODEL_BACKEND=mock
MODEL_ID=Qwen/Qwen3-4B
LOCAL_MODEL_ID=mlx-community/Qwen3-4B-Instruct-2507-4bit
PRELOAD_MODEL=false
MAX_NEW_TOKENS=900
TEMPERATURE=1.0
TOP_P=0.95
TOP_K=64
REQUEST_TIMEOUT_SECONDS=45

# --- 공용 vLLM 엔진 (추천 + 이미지 분석) ---
# MODEL_BACKEND=vllm 으로 두면 추천과 이미지 분석이 같은 서버의 같은 모델을 씁니다.
VLLM_BASE_URL=http://localhost:8001
VLLM_MODEL=gemma4-12b-qat
VLLM_API_KEY=EMPTY
VLLM_TIMEOUT_SECONDS=90
VISION_MAX_NEW_TOKENS=900
VISION_TEMPERATURE=0.0

# --- 이미지 다운로드 ---
IMAGE_MAX_BYTES=12582912
IMAGE_MAX_EDGE=1280
IMAGE_FETCH_TIMEOUT_SECONDS=15
# 이미지에서 금액을 못 읽었을 때 true 면 502, false 면 카테고리 추정가로 채웁니다.
STRICT_PRICE=false

# --- Google Calendar MCP ---
CALENDAR_MCP_URL=http://localhost:8300/mcp
CALENDAR_MCP_TIMEOUT_SECONDS=30
# 비워 두면 캘린더에 등록하지 않고 초안 JSON 만 만듭니다.
GOOGLE_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary
CALENDAR_DEFAULT_LEAD_DAYS=30
NOTIFICATION_LEAD_DAYS=7
DEFAULT_TIMEZONE=Asia/Seoul
