# Spring Boot의 AI_SERVICE_API_KEY와 동일하게 설정합니다.
API_KEY=local-development-key
MODEL_BACKEND=bedrock
BEDROCK_API_STYLE=invoke
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Bedrock 전용 샘플링. 0.0 은 메시지가 같은 틀로 굳고, 1.0 은 JSON 형식을 깨뜨립니다.
BEDROCK_TEMPERATURE=0.4
# 실제 키는 .env에만 입력하고 이 예시 파일에는 커밋하지 않습니다.
AWS_BEARER_TOKEN_BEDROCK=
# REQUEST_TIMEOUT_SECONDS 는 없어졌습니다. 한 값을 두 단계에 각각 걸어 최악 지연이
# 2배가 됐기 때문입니다. 단계별로 아래 두 값이 대신하며, 합(75초)이 백엔드에 권장한
# HTTP 타임아웃 90초보다 낮습니다. /recommend 도 TASK_TIMEOUT_SECONDS 를 씁니다.
IMAGE_ANALYSIS_TIMEOUT_SECONDS=45
TASK_TIMEOUT_SECONDS=30
TAVILY_ENABLED=false
TAVILY_API_KEY=
TAVILY_TIMEOUT_SECONDS=15
# Search 는 결과 수와 무관하게 1회 = 1크레딧이라 올려도 크레딧이 늘지 않습니다.
# PRODUCT_CANDIDATE_LIMIT 과 반드시 같이 올립니다(따로 올리면 효과가 반감됩니다).
TAVILY_MAX_RESULTS=12
PRODUCT_CANDIDATE_LIMIT=12
# Extract 과금 단위는 성공 URL 5개입니다. 대상은 5개로 두되 3개씩 나눠 보냅니다.
# 5개를 한 묶음으로 보내면 그 하나가 잘릴 때 전량 미확인이 됩니다(실측 4회 중 3회).
# [3, 2] 두 묶음이면 느린 URL 이 낀 쪽만 잘리고 나머지 가격은 살아남습니다.
TAVILY_EXTRACT_LIMIT=5
TAVILY_EXTRACT_BATCH_SIZE=3
# 성공한 Extract 는 1초 미만이었고, 실패는 제한 시간을 다 씁니다(실측).
# 이 값은 임계 경로라 그대로 응답 시간이 됩니다.
TAVILY_EXTRACT_TIMEOUT_SECONDS=3
# 판정은 창작이 아니라 판정입니다. 같은 제목이 실행마다 뒤집히지 않도록 greedy 로 둡니다.
PRODUCT_FILTER_TEMPERATURE=0.0
# 예산 안 상품이 모자랄 때 보충을 허용하는 이탈 폭(경계값 기준 ±15%).
# 추천 범위 자체가 중심값 기준 반폭 20% 라, 보충 폭은 그보다 좁아야 합니다.
PRODUCT_PRICE_SLACK_RATIO=0.15
